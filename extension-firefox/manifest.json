{
  "manifest_version": 2,
  "name": "SPX BRIDGE for BADOC HUB",
  "short_name": "SPX BRIDGE",
  "version": "69.2.2",
  "description": "Firefox Android-compatible build of the BADOC HUB SPX BRIDGE with integrated POD/POOH checking and the current BADOC Hub SPX workflows.",
  "permissions": [
    "cookies",
    "scripting",
    "tabs",
    "storage",
    "activeTab",
    "https://spx.shopee.ph/*",
    "https://*.susercontent.com/*",
    "https://*.file.susercontent.com/*",
    "https://nol3-hubs.github.io/*",
    "https://docs.google.com/*",
    "https://docs.googleusercontent.com/*",
    "https://accounts.google.com/*",
    "https://drive.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://sheets.google.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://localhost/*",
        "https://127.0.0.1/*",
        "https://nol3-hubs.github.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://spx.shopee.ph/*"
      ],
      "js": [
        "pod-checker/page_bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://spx.shopee.ph/*"
      ],
      "js": [
        "pod-checker/content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "spx-bridge-badoc-hub@nol3-hubs.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  },
  "web_accessible_resources": [
    "pod-checker/app.html",
    "pod-checker/app.js",
    "pod-checker/icon16.png",
    "pod-checker/icon32.png",
    "pod-checker/icon48.png",
    "pod-checker/icon128.png"
  ],
  "icons": {
    "16": "pod-checker/icon16.png",
    "32": "pod-checker/icon32.png",
    "48": "pod-checker/icon48.png",
    "128": "pod-checker/icon128.png"
  }
}
